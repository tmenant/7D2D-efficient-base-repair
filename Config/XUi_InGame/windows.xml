<configs>
    <append xpath="/windows">

        <window name="windowEfficientBaseRepairStats" width="{windowWidth}" height="203" panel="Left" controller="EfficientBaseRepairStats, EfficientBaseRepair">

            <rect name="header" height="43" depth="0">
                <sprite depth="1" name="headerbackground" sprite="ui_game_panel_header" width="{windowWidth}" />
                <sprite depth="3" name="windowIcon" style="icon32px" pos="5,-5" sprite="ui_game_symbol_block_damage" />
                <label depth="2" style="header.name" text="EBR Stats" text_key="xuiStats" />
            </rect>

            <rect name="content" pos="0,-46" height="156">

                <sprite name="background" color="[darkGrey]" type="sliced" width="{windowWidth}" />
                <sprite name="backgroundMain" color="[black]" type="sliced" sprite="menu_empty3px" fillcenter="false" width="{windowWidth}" />

                <grid name="stats" rows="5" cols="1" pos="8,-6" cell_height="30" repeat_content="false" width="{windowWidth}">
                    <label font_size="21" width="{windowWidth}" text="{lblBlocksToRepair}" />
                    <label font_size="21" width="{windowWidth}" text="{lblBlocksToUpgrade}" />
                    <label font_size="21" width="{windowWidth}" text="{lblTotalDamages}" />
                    <label font_size="21" width="{windowWidth}" text="{lblVisitedBlocks}" />
                    <label font_size="21" width="{windowWidth}" text="{lblTimer}" />
                </grid>
            </rect>

            <grid name="buttons" rows="4" cols="1" width="150" height="156" pos="{#windowWidth - 160},-60" cell_height="45" repeat_content="false">

                <rect name="btnOn" depth="3" height="36">
                    <sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" />
                    <sprite depth="2" name="background" sprite="menu_empty" height="32" color="[darkGrey]" type="sliced" />
                    <rect name="buttonRect" depth="3" pos="0,-3" height="31">
                        <button name="clickable" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" />
                        <sprite depth="2" name="sprOnOff" width="24" height="24" pos="10,-2" color="[iconColor]" sprite="ui_game_symbol_electric_switch" />
                        <label depth="2" name="lblOnOff" pos="40,-4" justify="left" text_key="xuiTurnOn" font_size="24" />
                    </rect>
                </rect>

                <rect name="btnRefresh" depth="3" height="36">
                    <sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" />
                    <sprite depth="2" name="background" sprite="menu_empty" height="32" color="[darkGrey]" type="sliced" />
                    <rect name="buttonRect" depth="3" pos="0,-3" height="31">
                        <button name="clickable" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" />
                        <sprite depth="1" name="sprRefresh" width="24" height="24" pos="10,-2" color="[iconColor]" sprite="ui_game_symbol_scrap" />
                        <label depth="2" name="lblRefresh" pos="40,-4" justify="left" font_size="24" />
                    </rect>
                </rect>

                <rect name="btnUpgrade" depth="3" height="36">
                    <sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" />
                    <sprite depth="2" name="background" sprite="menu_empty" height="32" color="[darkGrey]" type="sliced" />
                    <rect name="buttonRect" depth="3" pos="0,-3" height="31">
                        <button name="clickable" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" />
                        <sprite depth="2" name="sprUpgrade" width="24" height="24" pos="10,-2" color="[iconColor]" sprite="ui_game_symbol_resource" />
                        <label depth="2" name="lblupgrade" pos="40,-4" justify="left" text_key="xuiTurnOn" font_size="24" />
                    </rect>
                </rect>

            </grid>
        </window>

        <window name="windowEfficientBaseRepairMaterials" width="260" height="1000" panel="Right" controller="EfficientBaseRepairMaterials, EfficientBaseRepair" cursor_area="true">

            <rect style="header.panel">
                <sprite name="headerbackground" sprite="ui_game_panel_header" />
                <sprite style="header.icon" sprite="ui_game_symbol_forge" />
                <label style="header.name" text_key="xuiMaterials" />
                <pager name="pager" pos="155,-6" contents_parent="content" />
            </rect>

            <grid name="materialsPanel" on_scroll="true" rows="16" cols="1" pos="0, -49" width="260" cell_width="260" cell_height="46" repeat_content="true" arrangement="vertical">
                <ebr_material_entry name="0" />
            </grid>

        </window>
    </append>
</configs>